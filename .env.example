# Kopier denne filen til .env før du endrer noe. .env skal aldri committes.
# Appen starter uten .env, i mock-modus.

# Modus: mock (standard, ingen data sendes ut) eller api (ekte språkmodell, krever nøkkel)
SUPERSOKER_MODE=mock

# Hvor kontodatabasen ligger (opprettes automatisk). Standard er data/supersoker.db.
# SUPERSOKER_DATABASE=data/supersoker.db

# Brukes bare i api-modus. La stå tom i mock-modus.
OPENAI_API_KEY=
